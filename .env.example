# ===========================================
# SENTINELLAB — Environment Configuration
# ===========================================
# Copy to .env and fill in real values.
# NEVER commit .env to source control.

# --- Mode ---
MOCK_MODE=true

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- S3 ---
S3_BUCKET_NAME=sentinellab-projects

# --- DynamoDB ---
DYNAMODB_TABLE_NAME=SentinelLabScans

# --- Bedrock Model IDs ---
ANALYZER_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
SECURITY_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
REPAIR_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
JUDGE_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# --- AgentCore ---
AGENTCORE_SANDBOX_ID=

# --- Worker Lambda ---
WORKER_LAMBDA_NAME=sentinellab-worker

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend ---
VITE_API_URL=http://localhost:8000
